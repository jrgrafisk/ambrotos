# OVH VPS Environment Configuration
# Copy this to .env on your OVH VPS

# Required: Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Flask secret key - generate with: openssl rand -hex 32
SECRET_KEY=your_long_random_secret_key_here

# PostgreSQL database password (used in docker-compose.yml)
POSTGRES_PASSWORD=your_strong_postgres_password_here

# FTP backup configuration (optional)
# These are the same as in your .env.example
FTP_HOST=ftp.jrgrafisk.dk
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password
FTP_PATH=/customers/5/2/d/jrgrafisk.dk/httpd.www/ambrotos
